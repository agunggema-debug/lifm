{
  "name": "lifm-root",
  "private": true,
  "version": "1.0.0",
  "description": "Liga Indonesia Football Manager - open source web game",
  "scripts": {
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "npm --prefix frontend run build",
    "test:api": "cd backend && node test-api.mjs",
    "test:promotion": "cd backend && node test-promotion.mjs",
    "test:calendar": "cd backend && node test-calendar.mjs"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
